{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"],
  // The app/server contract test imports ../server, which the frontend's
  // Railway build does not have (it builds app/ alone). Vitest still runs it
  // locally; it is just left out of the deploy typecheck.
  "exclude": ["src/questionnaire/contract.test.ts"]
}
